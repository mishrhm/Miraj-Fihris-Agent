# Google AI Studio API Key
GEMINI_API_KEY=your_gemini_api_key_here

# WooCommerce REST API Configuration
WC_URL=https://www.maat.ae
WC_CK=ck_your_woocommerce_consumer_key_here
WC_CS=cs_your_woocommerce_consumer_secret_here

# WordPress Application Password (WP Admin -> Users -> Profile -> Application
# Passwords). Required only for uploading local image files to the media
# library -- the WooCommerce keys above cannot authorize wp/v2/media.
WP_USERNAME=your_wp_admin_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Application Settings
APP_ENV=development
PORT=8000